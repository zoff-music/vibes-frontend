{
  "name": "@vibes/serve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./assets": "./src/assets.ts",
    "./critical-css/vite": "./src/criticalCssVite.ts",
    ".": "./src/index.ts",
    "./precompress": "./src/precompress.ts",
    "./theme": "./src/theme.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --workspace-root exec vitest run --project serve"
  },
  "dependencies": {
    "@kasperrt/smolter": "catalog:",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prometheus-io/client": "0.16.1",
    "@vibes/shared": "workspace:*",
    "beasties": "0.5.5",
    "compression": "1.8.2",
    "express": "5.3.0",
    "negotiator": "^1.1.0"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/negotiator": "^0.6.5",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
