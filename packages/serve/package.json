{
  "name": "@vibes/serve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./assets": "./src/assets.ts",
    ".": "./src/index.ts",
    "./precompress": "./src/precompress.ts",
    "./theme": "./src/theme.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "lint": "biome check src",
    "test:frame-protection": "node --test src/frameProtection.test.ts",
    "test:transport": "node --test src/transport.test.ts src/cache.test.ts src/revalidation.test.ts src/deployment.test.ts src/prefetch.test.ts",
    "typecheck": "tsc --noEmit",
    "test:theme": "node --test src/theme.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prometheus-io/client": "0.16.1",
    "@vibes/shared": "workspace:*",
    "compression": "1.8.2",
    "express": "5.3.0",
    "negotiator": "^1.1.0",
    "@kasperrt/smolter": "0.4.6"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/negotiator": "^0.6.5",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
