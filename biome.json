{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "!**/node_modules",
      "!**/dist",
      "!apps/**/e2e",
      "!apps/**/playwright-report",
      "!**/.last-run.json",
      "!**/.react-router",
      "!**/.expo",
      "!**/coverage",
      "!**/test-results",
      "!apps/*/android",
      "!apps/*/ios"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "useKeyWithClickEvents": "off",
        "noAutofocus": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error"
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnknownFunction": "off"
      },
      "suspicious": {
        "noImplicitAnyLet": "error",
        "noExplicitAny": "error",
        "noUnknownAtRules": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "mergeFunctions": ["clsx", "tw"],
    "variantFunctions": ["cva"]
  },
  "overrides": [
    {
      "includes": [
        "apps/admin/**",
        "apps/cast/**",
        "apps/embed/**",
        "apps/platform/**",
        "apps/remote/**",
        "apps/tv/src/tizen/**",
        "packages/ui/src/web/**",
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          }
        }
      }
    }
  ]
}
