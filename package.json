{
  "name": "vibes-frontend",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @vibes/platform dev",
    "build": "pnpm --filter @vibes/platform build && pnpm --filter @vibes/admin build && pnpm --filter @vibes/cast build && pnpm --filter @vibes/embed build && pnpm --filter @vibes/remote build && pnpm --filter @vibes/tv build",
    "typecheck": "tsc -p tsconfig.tests.json && pnpm --parallel --recursive typecheck",
    "lint": "biome check --error-on-warnings vitest.config.mts tsconfig.tests.json && pnpm check:api-boundaries && pnpm --parallel --recursive lint",
    "check:api-boundaries": "biome check --error-on-warnings scripts && node scripts/check-api-boundaries.mjs",
    "fix": "biome check --write --unsafe .",
    "test": "pnpm --parallel --filter @vibes/platform --filter @vibes/tv build && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vibes/models": "workspace:*",
    "@vibes/shared": "workspace:*",
    "@vibes/tailwind": "workspace:*",
    "@vibes/ui": "workspace:*",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "tailwindcss": "catalog:",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "dependencies": {
    "@kasperrt/smolter": "catalog:",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
