{
  "name": "@vibes/remote",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3007",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry.server.tsx --outDir dist/server",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src server",
    "preview": "node server/index.ts"
  },
  "dependencies": {
    "@kasperrt/smolter": "0.4.5",
    "@vibes/api": "workspace:*",
    "@vibes/models": "workspace:*",
    "@vibes/serve": "workspace:*",
    "@vibes/shared": "workspace:*",
    "@vibes/ui": "workspace:*",
    "jsqr": "1.4.0",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vibes/tailwind": "workspace:*",
    "tailwindcss": "catalog:",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
