{
  "name": "@vibes/platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001",
    "build": "vite build --outDir dist/client && CRITICAL_CSS=false vite build --ssr src/entry.server.tsx --outDir dist/server",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings src tests",
    "preview": "node server/index.ts",
    "test": "pnpm --workspace-root exec vitest run --project platform"
  },
  "dependencies": {
    "@kasperrt/smolter": "catalog:",
    "@vibes/api": "workspace:*",
    "@vibes/models": "workspace:*",
    "@vibes/serve": "workspace:*",
    "@vibes/shared": "workspace:*",
    "@vibes/ui": "workspace:*",
    "framer-motion": "14.13.0",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "qrcode.react": "4.2.0",
    "valibot": "1.5.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/chromecast-caf-sender": "1.0.11",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vibes/tailwind": "workspace:*",
    "tailwindcss": "catalog:",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
