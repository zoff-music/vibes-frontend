{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "customConditions": ["react-native-legacy-deep-imports"],
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "nativewind-env.d.ts"]
}
