{
  "name": "@vibes/tv",
  "version": "0.1.9",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start --dev-client",
    "android": "EXPO_TV=1 expo run:android",
    "android:prebuild": "EXPO_TV=1 expo prebuild",
    "android:build:development": "pnpm dlx eas-cli build --platform android --profile development",
    "android:build:preview": "pnpm dlx eas-cli build --platform android --profile preview",
    "android:build:production": "pnpm dlx eas-cli build --platform android --profile production",
    "android:submit": "pnpm dlx eas-cli submit --platform android --profile production",
    "tizen:dev": "vite --config vite.tizen.config.ts",
    "tizen:build": "vite build --config vite.tizen.config.ts",
    "build": "pnpm tizen:build",
    "lint": "biome check src app.json metro.config.js vite.tizen.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "EXPO_TV=1 expo config --type public && tsc --noEmit && pnpm tizen:build"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/jersey-15": "0.4.1",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@vibes/api": "workspace:*",
    "@vibes/models": "workspace:*",
    "@vibes/native-router": "workspace:*",
    "@vibes/shared": "workspace:*",
    "@vibes/ui": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "expo": "~57.0.14",
    "expo-asset": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "nativewind": "5.0.0-preview.4",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-css": "3.0.7",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "2.4.1",
    "react-router": "8.3.0",
    "tailwindcss": "catalog:",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.16",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.18",
    "typescript": "~6.0.3"
  }
}
