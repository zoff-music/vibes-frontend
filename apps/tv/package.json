{
  "name": "@vibes/tv",
  "version": "0.6.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start --dev-client",
    "android": "EXPO_TV=1 expo run:android",
    "android:prebuild": "EXPO_TV=1 expo prebuild",
    "android:build:development": "pnpm dlx eas-cli build --platform android --profile development",
    "android:build:preview": "pnpm dlx eas-cli build --platform android --profile preview",
    "android:build:production": "pnpm dlx eas-cli build --platform android --profile production",
    "android:submit": "pnpm dlx eas-cli submit --platform android --profile production",
    "tizen:dev": "vite --config vite.tizen.config.ts",
    "tizen:build": "vite build --config vite.tizen.config.ts && node scripts/finalize-tizen.mjs",
    "tizen:test": "node --test scripts/*.test.mjs",
    "build": "pnpm tizen:build",
    "lint": "biome check src scripts app.json metro.config.js vite.tizen.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "validate": "EXPO_TV=1 expo config --type public && pnpm typecheck && pnpm tizen:build && pnpm tizen:test"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-webview",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@kasperrt/smolter": "0.4.10",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@vibes/api": "workspace:*",
    "@vibes/models": "workspace:*",
    "@vibes/shared": "workspace:*",
    "@vibes/ui": "workspace:*",
    "core-js": "3.51.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "nativewind": "5.0.0-preview.4",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-css": "3.0.7",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "2.4.1",
    "tailwindcss": "catalog:",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@vibes/serve": "workspace:*",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "postcss-preset-env": "11.6.1",
    "typescript": "~7.0.2"
  }
}
